@model CMS.Data.Entities.User

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm thành viên";
}

<div class="container mt-4">

    ```
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">
                THÊM THÀNH VIÊN HỆ THỐNG
            </h5>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Username"
                               class="form-label fw-bold">
                            Tên đăng nhập
                        </label>

                        <input asp-for="Username"
                               class="form-control"
                               placeholder="Ví dụ: admin_loi"
                               required />

                        <span asp-validation-for="Username"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PasswordHash"
                               class="form-label fw-bold">
                            Mật khẩu
                        </label>

                        <input asp-for="PasswordHash"
                               type="password"
                               class="form-control"
                               minlength="6"
                               required />

                        <span asp-validation-for="PasswordHash"
                              class="text-danger">
                        </span>

                        <small class="text-muted">
                            Mật khẩu tối thiểu 6 ký tự.
                        </small>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName"
                               class="form-label fw-bold">
                            Họ và tên
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Nguyễn Đình Lợi"
                               required />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Role"
                               class="form-label fw-bold">
                            Quyền hạn
                        </label>

                        <select asp-for="Role"
                                class="form-select"
                                required>
                            <option value="">
                                -- Chọn quyền hạn --
                            </option>

                            <option value="Admin">
                                Quản trị viên (Admin)
                            </option>

                            <option value="Editor">
                                Biên tập viên (Editor)
                            </option>
                        </select>

                        <span asp-validation-for="Role"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <hr />

                <button type="submit"
                        class="btn btn-primary">
                    Lưu thành viên
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>

            </form>

        </div>
    </div>
    ```

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
