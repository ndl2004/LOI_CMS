@model CMS.Data.Entities.User

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Cập nhật thành viên";
}

<div class="container mt-4">

    <div class="card shadow border-0">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
                CẬP NHẬT THÔNG TIN THÀNH VIÊN
            </h5>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row mb-3">

                    <div class="col-md-6">
                        <label asp-for="Username"
                               class="form-label fw-bold">
                            Tên đăng nhập
                        </label>

                        <input asp-for="Username"
                               class="form-control"
                               readonly />

                        <small class="text-muted">
                            Tên đăng nhập không được phép sửa.
                        </small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">
                            Mật khẩu mới
                        </label>

                        <input type="password"
                               name="NewPassword"
                               class="form-control"
                               minlength="6"
                               placeholder="Để trống nếu không muốn đổi mật khẩu" />

                        <small class="text-muted">
                            Nếu nhập mật khẩu mới, hệ thống sẽ mã hóa bằng BCrypt trước khi lưu.
                        </small>
                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-md-6">
                        <label asp-for="FullName"
                               class="form-label fw-bold">
                            Họ và tên
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               required />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Role"
                               class="form-label fw-bold">
                            Vai trò
                        </label>

                        <select asp-for="Role"
                                class="form-select"
                                required>
                            <option value="Admin">
                                Admin
                            </option>

                            <option value="Editor">
                                Editor
                            </option>
                        </select>

                        <span asp-validation-for="Role"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <hr />

                <button type="submit"
                        class="btn btn-primary">
                    Cập nhật
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}