@model IEnumerable<CMS.Data.Entities.FlashSale>

@{
    Layout = "_LayoutAdmin";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="text-primary mb-1">FLASH SALE</h2>
            <small class="text-muted">Quản lý các đợt khuyến mãi theo thời gian</small>
        </div>

        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Tạo flash sale
        </a>
    </div>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Tên chương trình</th>
                <th>Thời gian</th>
                <th>Sản phẩm</th>
                <th>Trạng thái</th>
                <th width="210">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var now = DateTime.Now;
                var isRunning = item.IsActive && item.StartTime <= now && item.EndTime >= now;

                <tr>
                    <td>@item.Id</td>
                    <td><strong>@item.Name</strong></td>
                    <td>
                        <div>@item.StartTime.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="text-muted">đến @item.EndTime.ToString("dd/MM/yyyy HH:mm")</div>
                    </td>
                    <td>@(item.FlashSaleItems?.Count ?? 0)</td>
                    <td>
                        @if (isRunning)
                        {
                            <span class="badge bg-success">Đang chạy</span>
                        }
                        else if (!item.IsActive)
                        {
                            <span class="badge bg-secondary">Đã tắt</span>
                        }
                        else if (item.StartTime > now)
                        {
                            <span class="badge bg-info">Sắp diễn ra</span>
                        }
                        else
                        {
                            <span class="badge bg-dark">Đã kết thúc</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil"></i> Sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
