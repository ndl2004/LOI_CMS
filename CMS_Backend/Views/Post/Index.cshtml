@model IEnumerable<CMS.Data.Entities.Post>

@{
    Layout = "_LayoutAdmin";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<style>
    .post-card {
        height: 100%;
        border: none;
        border-radius: 16px;
        overflow: hidden;
        transition: .25s ease;
    }

        .post-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,.12);
        }

    .post-thumb {
        width: 100%;
        height: 210px;
        object-fit: cover;
        background: #f3f3f3;
    }

    .post-card .card-body {
        min-height: 230px;
        display: flex;
        flex-direction: column;
    }

    .post-title {
        font-size: 18px;
        font-weight: 700;
        margin-top: 10px;
        min-height: 48px;
        line-height: 1.35;
    }

    .post-summary {
        color: #666;
        font-size: 14px;
        line-height: 1.6;
        height: 46px;
        overflow: hidden;
        margin-bottom: 10px;
    }

    .post-actions {
        margin-top: auto;
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .admin-pagination {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 28px;
        flex-wrap: wrap;
    }

        .admin-pagination a,
        .admin-pagination span {
            min-width: 38px;
            height: 38px;
            padding: 0 12px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            border: 1px solid #dee2e6;
            color: #333;
            background: #fff;
            font-weight: 600;
        }

            .admin-pagination a:hover {
                background: #0d6efd;
                color: #fff;
                border-color: #0d6efd;
            }

        .admin-pagination .active {
            background: #0d6efd;
            color: #fff;
            border-color: #0d6efd;
        }

        .admin-pagination .disabled {
            opacity: .45;
            pointer-events: none;
        }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark mb-1">DANH SÁCH BÀI VIẾT</h2>
            <small class="text-muted">
                Quản lý nội dung bài viết hiển thị trên website
            </small>
        </div>

        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm bài viết mới
        </a>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            var plainText = System.Text.RegularExpressions.Regex.Replace(
            item.Content ?? "",
            "<.*?>",
            ""
            );

            <div class="col-md-4">
                <div class="card shadow-sm post-card">

                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl"
                             class="post-thumb"
                             alt="@item.Title" />
                    }
                    else
                    {
                        <div class="post-thumb d-flex align-items-center justify-content-center text-muted">
                            Chưa có ảnh
                        </div>
                    }

                    <div class="card-body">
                        <div>
                            <span class="badge bg-info text-dark">
                                @(item.Category != null ? item.Category.Name : "Chưa có danh mục")
                            </span>
                        </div>

                        <div class="post-title text-primary">
                            @item.Title
                        </div>

                        <div class="post-summary">
                            @plainText
                        </div>

                        <p class="text-muted small mb-3">
                            Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                        </p>

                        <div class="post-actions">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                Xem
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-warning btn-sm">
                                Sửa
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm"
                               onclick="return confirm('Chúng ta có chắc chắn muốn xóa bài viết này không?')">
                                Xóa
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="admin-pagination">
            <a asp-action="Index"
               asp-route-page="@(currentPage - 1)"
               class="@(currentPage == 1 ? "disabled" : "")">
                ← Trước
            </a>

            @for (int i = 1; i <= totalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-page="@i"
                   class="@(i == currentPage ? "active" : "")">
                    @i
                </a>
            }

            <a asp-action="Index"
               asp-route-page="@(currentPage + 1)"
               class="@(currentPage == totalPages ? "disabled" : "")">
                Sau →
            </a>
        </div>
    }
</div>