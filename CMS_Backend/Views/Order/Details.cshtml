@model CMS.Data.Entities.Order

@{
    Layout = "_LayoutAdmin";

    var subTotal = Model.OrderDetails?.Sum(d => d.Quantity * d.UnitPrice) ?? 0;
    var totalAmount = Model.TotalAmount > 0 ? Model.TotalAmount : subTotal + Model.ShippingFee;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Chi tiết đơn hàng #@Model.Id</h2>

        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa đơn</a>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-bold">Thông tin đơn hàng</div>
                <div class="card-body">
                    <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Khách hàng:</strong> @Model.Customer?.FullName</p>
                    <p><strong>Phương thức:</strong> @(Model.PaymentMethod ?? "COD")</p>
                    <div class="mb-3">
                        <strong>Trạng thái:</strong>
                        @if (Model.Status == 0)
                        {
                            <form asp-action="ChangeStatus" method="post" class="mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <select name="status" class="form-select" onchange="this.form.submit()">
                                    <option value="0" selected>Chờ duyệt</option>
                                    <option value="1">Đã duyệt / Đang giao</option>
                                    <option value="3">Từ chối</option>
                                </select>
                            </form>
                        }
                        else if (Model.Status == 1)
                        {
                            <span class="badge bg-primary">Đã duyệt / Đang giao</span>
                        }
                        else if (Model.Status == 2)
                        {
                            <span class="badge bg-success">Hoàn thành</span>
                        }
                        else if (Model.Status == 3)
                        {
                            <span class="badge bg-danger">Từ chối</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Không xác định</span>
                        }
                    </div>
                    <p><strong>Ghi chú:</strong> @(Model.Notes ?? "Không có")</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-bold">Thông tin giao hàng</div>
                <div class="card-body">
                    <p><strong>Người nhận:</strong> @(Model.ReceiverName ?? Model.Customer?.FullName)</p>
                    <p><strong>Email:</strong> @(Model.ReceiverEmail ?? Model.Customer?.Email)</p>
                    <p><strong>Số điện thoại:</strong> @(Model.ReceiverPhone ?? Model.Customer?.Phone)</p>
                    <p><strong>Địa chỉ:</strong> @(Model.ShippingAddress ?? Model.Customer?.Address)</p>
                </div>
            </div>
        </div>
    </div>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Giá gốc</th>
                <th>Đơn giá</th>
                <th>Khuyến mãi</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderDetails ?? new List<CMS.Data.Entities.OrderDetail>())
            {
                var originalPrice = item.OriginalPrice > 0
                    ? item.OriginalPrice
                    : item.Product?.Price ?? item.UnitPrice;
                var hasDiscount = item.IsFlashSale || originalPrice > item.UnitPrice;

                <tr>
                    <td>@(item.ProductName ?? item.Product?.Name)</td>
                    <td>@item.Quantity</td>
                    <td>@originalPrice.ToString("N0") đ</td>
                    <td>@item.UnitPrice.ToString("N0") đ</td>
                    <td>
                        @if (hasDiscount && item.DiscountPercent > 0)
                        {
                            <span class="badge bg-danger">Flash Sale -@item.DiscountPercent%</span>
                        }
                        else if (hasDiscount)
                        {
                            <span class="badge bg-danger">Giá ưu đãi</span>
                        }
                        else
                        {
                            <span class="text-muted">Không có</span>
                        }
                    </td>
                    <td class="fw-bold text-danger">@((item.Quantity * item.UnitPrice).ToString("N0")) đ</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="card ms-auto" style="max-width: 420px;">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <span>Tạm tính</span>
                <strong>@subTotal.ToString("N0") đ</strong>
            </div>
            <div class="d-flex justify-content-between mt-2">
                <span>Phí vận chuyển</span>
                <strong>@Model.ShippingFee.ToString("N0") đ</strong>
            </div>
            <hr />
            <div class="d-flex justify-content-between fs-5 text-danger">
                <span>Tổng tiền</span>
                <strong>@totalAmount.ToString("N0") đ</strong>
            </div>
        </div>
    </div>
</div>
